# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Environment variables ----
# Ignore all .env files ...
.env
.env.*
.env.local
# ... but always allow the example templates
!**/.env.example

# ---- Build outputs ----
/dist
/build
/frontend/build

# ---- Test coverage ----
coverage/
.nyc_output/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Runtime / process ----
pids/
*.pid
*.seed
*.pid.lock

# ---- Database ----
*.db
*.sqlite
backend/data/*.db

# ---- Claude Code internals ----
.claude/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.code-workspace

# ---- Misc ----
*.tmp
*.temp
*.pem
*.key
.cache/
.parcel-cache/
