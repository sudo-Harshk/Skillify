# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000

# Optional: Override the Gemini model used for question generation (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Rate limit per IP per minute for question generation/evaluation endpoints (default: 20)
RATE_LIMIT_RPM=20
